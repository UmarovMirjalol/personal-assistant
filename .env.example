# ─── App ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NODE_ENV=production

# ─── Telegram ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs. Leave empty to lock to first /start user.
TELEGRAM_ALLOWED_USER_IDS=
# Random secret verified on webhook requests (?secret=...)
TELEGRAM_WEBHOOK_SECRET=

# ─── Google / Gmail OAuth ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console redirect URI
GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/google/callback
# Optional: Gmail Pub/Sub topic for push (projects/PROJECT/topics/TOPIC)
GMAIL_PUBSUB_TOPIC=

# ─── Gemini ────────────────────────────────────────────
GEMINI_API_KEY=
# Free-tier friendly default
GEMINI_MODEL=gemini-3.6-flash

# ─── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ──────────────────────────────────────────
# 32+ byte secret for AES-256-GCM token encryption (hex or base64)
TOKEN_ENCRYPTION_KEY=
# Protects /api/cron/* endpoints
CRON_SECRET=

# ─── Optional web search (Serper.dev free tier) ─────────
# If unset, DuckDuckGo HTML search is used as free fallback
SERPER_API_KEY=
